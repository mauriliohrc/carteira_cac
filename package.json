  "scripts": {
    "start": "expo start --ios",
    "start:tunnel": "expo start --ios --tunnel",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "web": "expo export --platform web --output-dir dist && node scripts/servir-web.mjs dist 8080",
    "web:servir": "node scripts/servir-web.mjs dist 8080",
    "android": "expo run:android",
    "simulador": "./scripts/preparar-simulador.sh",
    "test": "node --experimental-strip-types --import ./testes/alias.mjs testes/planejamento.test.ts && node --experimental-strip-types --import ./testes/alias.mjs testes/variantes-plataforma.test.ts && node --experimental-strip-types --import ./testes/alias.mjs testes/backup.test.ts && node --experimental-strip-types --import ./testes/alias.mjs testes/pin.test.ts && node --experimental-strip-types --import ./testes/alias.mjs testes/habitualidade.test.ts",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup-secrets.mjs",
    "versao": "node scripts/versao.mjs",
    "versao:bump:ios": "node scripts/versao.mjs bump ios",
    "versao:bump:android": "node scripts/versao.mjs bump android",
    "versao:bump": "node scripts/versao.mjs bump both",
    "doctor": "npx expo-doctor",
    "build:dev": "eas build --profile development --platform ios",
    "build:preview": "eas build --profile preview --platform ios",
    "build:prod": "eas build --profile production --platform ios"
  },
  "private": true
}
