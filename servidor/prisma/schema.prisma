// ============================================================================
// Schema do banco — CAC Brasil  (MySQL)
//
// Mantemos só tipos portáveis de propósito (herança do SQLite, para trocar de
// banco sem reescrever regra de negócio):
//   - sem enum nativo    -> "enums" são String validados por Zod na aplicação
//   - sem campo Json     -> metadados ficam em String (@db.LongText onde grande)
//   - ids em cuid (String) e datas em DateTime
// No MySQL, `String` vira VARCHAR(191) por padrão; campos de texto livre, URLs
// e JSON de sync recebem @db.Text / @db.LongText para não truncar.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Administrador do APLICATIVO (dono/operador do backoffice).
/// NÃO confundir com os usuários administrativos das entidades.
model UsuarioAdmin {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  senhaHash    String
  /// SUPER_ADMIN | SUPORTE  (validado por Zod)
  papel        String   @default("SUPER_ADMIN")
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  noticias Noticia[]

  @@map("usuarios_admin")
}

/// Notícia publicada pelo admin do app e exibida no aplicativo.
/// Só aparece no app quando status = PUBLICADA.
model Noticia {
  id           String    @id @default(cuid())
  titulo       String
  resumo       String?   @db.Text
  conteudo     String    @db.LongText
  imagemUrl    String?   @db.Text
  /// RASCUNHO | PUBLICADA  (validado por Zod)
  status       String    @default("RASCUNHO")
  /// Marca quando foi publicada; null enquanto rascunho. Ordena a lista do app.
  publicadaEm  DateTime?
  autorId      String?
  /// Alcance da notícia: null = GERAL (todos os usuários do app veem).
  /// Preenchido = restrita aos usuários vinculados a esta entidade.
  entidadeId   String?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  autor    UsuarioAdmin?    @relation(fields: [autorId], references: [id], onDelete: SetNull)
  entidade EntidadeTiro?    @relation(fields: [entidadeId], references: [id], onDelete: Cascade)
  midias   MidiaNoticia[]
  leituras LeituraNoticia[]

  @@index([status, publicadaEm])
  @@index([entidadeId, status, publicadaEm])
  @@map("noticias")
}

/// Marca que um usuário do app LEU uma notícia (uma linha por usuário/notícia).
/// Serve para contar quantas pessoas leram cada notícia.
model LeituraNoticia {
  id        String   @id @default(cuid())
  noticiaId String
  usuarioId String
  criadoEm  DateTime @default(now())

  noticia Noticia    @relation(fields: [noticiaId], references: [id], onDelete: Cascade)
  usuario UsuarioApp @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([noticiaId, usuarioId])
  @@index([noticiaId])
  @@map("leituras_noticia")
}

/// Mídia de uma notícia (galeria): foto ou vídeo do YouTube, em ordem.
model MidiaNoticia {
  id        String   @id @default(cuid())
  noticiaId String
  /// IMAGEM | YOUTUBE  (validado por Zod; string para permitir novos tipos)
  tipo      String
  /// URL da imagem ou do vídeo do YouTube.
  url       String   @db.Text
  legenda   String?  @db.Text
  /// Posição na galeria (0 = primeira).
  ordem     Int      @default(0)
  criadoEm  DateTime @default(now())

  noticia Noticia @relation(fields: [noticiaId], references: [id], onDelete: Cascade)

  @@index([noticiaId])
  @@map("midias_noticia")
}

/// Entidade de tiro: clube, liga ou federação. Criada e gerida pelo admin do app.
model EntidadeTiro {
  id         String  @id @default(cuid())
  nome       String
  /// Subdomínio público, gerado do nome no cadastro (ex.: "3Gun" -> "3gun" ->
  /// 3gun.carteiracac.com). Único; nulo em entidades antigas até o backfill.
  subdominio String? @unique
  /// CLUBE | LIGA | FEDERACAO  (validado por Zod)
  tipo       String
  /// Registro no Exército (CR), quando houver.
  cr         String?
  cnpj       String? @unique
  email      String?
  telefone   String?
  cidade     String?
  uf         String?
  ativo      Boolean @default(true)

  // ---- Integração Shooting House (API de parceiros) ----
  shIntegracaoAtiva Boolean @default(false)
  /// Base da API; se nulo, usa o padrão (beta). Ex.: https://apibeta.shootinghouse.com.br/v1/partners
  shBaseUrl         String? @db.Text
  /// Credenciais Basic do parceiro na Shooting House.
  shLogin           String?
  shSenha           String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarios    UsuarioEntidade[]
  vinculosApp VinculoEntidade[]
  noticias    Noticia[]
  competicoes Competicao[]

  @@map("entidades_tiro")
}

/// Arquivo enviado pelo backoffice (ex.: banner de competição). Guardado no
/// banco (como os anexos do app) e servido em GET /uploads/:id.
model Upload {
  id       String   @id @default(cuid())
  mime     String
  tamanho  Int
  dados    Bytes
  criadoEm DateTime @default(now())

  @@map("uploads")
}

/// Competição criada por uma ENTIDADE. Agrupa categorias; cada categoria tem
/// seu próprio ranking. Só aparece no app enquanto `ativo` e dentro do prazo.
model Competicao {
  id           String   @id @default(cuid())
  entidadeId   String
  nome         String
  /// Descrição/apresentação da competição.
  descricao    String?  @db.Text
  /// Foto/banner (URL). Exibido no app.
  bannerUrl    String?  @db.Text
  /// Regulamento completo (texto livre).
  regras       String?  @db.LongText
  dataInicio   DateTime
  dataFim      DateTime
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  entidade   EntidadeTiro          @relation(fields: [entidadeId], references: [id], onDelete: Cascade)
  categorias CategoriaCompeticao[]

  @@index([entidadeId])
  @@index([ativo, dataFim])
  @@map("competicoes")
}

/// Categoria dentro de uma competição. Tem o próprio ranking e o sentido do
/// ordenamento: MAIOR (maior pontuação vence) ou MENOR (menor vence, ex.: tempo).
model CategoriaCompeticao {
  id           String    @id @default(cuid())
  competicaoId String
  nome         String
  descricao    String?   @db.Text
  regras       String?   @db.LongText
  dataInicio   DateTime?
  dataFim      DateTime?
  /// MAIOR | MENOR  (validado por Zod). Sentido do ranking.
  ordenamento  String    @default("MAIOR")
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  competicao Competicao            @relation(fields: [competicaoId], references: [id], onDelete: Cascade)
  resultados ResultadoCompeticao[]

  @@index([competicaoId])
  @@map("categorias_competicao")
}

/// Resultado de um atirador numa categoria. Identificado pelo CPF; o nome vem
/// do usuário do app (se houver conta) ou da Shooting House da entidade.
/// Um atirador tem no máximo um resultado por categoria.
model ResultadoCompeticao {
  id           String   @id @default(cuid())
  categoriaId  String
  /// CPF só com dígitos (11).
  cpf          String
  /// Nome exibido no ranking.
  nome         String
  /// Pontuação (Float: aceita tempo/decimais).
  pontuacao    Float
  /// Vínculo opcional ao usuário do app, quando o CPF tem conta.
  usuarioId    String?
  /// APP | SHOOTING_HOUSE | MANUAL — de onde veio o nome.
  origemNome   String   @default("MANUAL")
  observacao   String?  @db.Text
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  categoria CategoriaCompeticao @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  usuario   UsuarioApp?         @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@unique([categoriaId, cpf])
  @@index([categoriaId])
  @@index([usuarioId])
  @@map("resultados_competicao")
}

/// Usuário FINAL do aplicativo (o CAC). Conta opcional: o app funciona 100%
/// offline sem ela. Não se confunde com UsuarioAdmin nem UsuarioEntidade.
/// Futuramente poderá ser vinculado a uma ou mais entidades.
model UsuarioApp {
  id                       String    @id @default(cuid())
  /// CPF só com dígitos (11). Único.
  cpf                      String    @unique
  email                    String    @unique
  nome                     String
  senhaHash                String
  /// Celular para contato/suporte (opcional). Só dígitos.
  celular                  String?
  emailVerificado          Boolean   @default(false)
  ativo                    Boolean   @default(true)
  /// Última atividade do usuário (heartbeat do app). "Online" = recente.
  ultimoAcessoEm           DateTime?
  /// Última verificação automática de vínculos na Shooting House (throttle).
  vinculosCheckEm          DateTime?
  /// Premium reportado pelo app (assinatura/cupom ativos neste aparelho).
  premium                  Boolean   @default(false)
  /// Origem do premium reportada pelo app: CUPOM | MENSAL | ANUAL | ANUAL_PARCEIRO.
  /// Nulo quando desconhecido (app antigo que só reporta o booleano) ou sem premium.
  premiumTipo              String?
  /// Id do cliente no Asaas (criado sob demanda na 1ª cobrança do Despachante).
  /// Só servidor — nunca entra no JSON de sincronização.
  asaasCustomerId          String?
  /// UUID estável desta conta usado como `appAccountToken` nas compras da App
  /// Store: o app o envia na compra e a Apple o devolve nas notificações, o que
  /// casa a assinatura com a conta no servidor. Gerado sob demanda.
  appAccountToken          String?   @unique
  /// Quando o usuário recebeu a oferta de reconquista Premium Parceiro (win-back
  /// do backoffice). Enquanto preenchida, o app libera a compra do plano parceiro
  /// mesmo sem vínculo de entidade. Null = sem oferta ativa.
  winbackParceiroEm        DateTime?
  /// Quando aceitou o EULA do marketplace (exigido antes de anunciar). Null = nunca.
  aceitouEulaMarketplaceEm DateTime?
  criadoEm                 DateTime  @default(now())
  atualizadoEm             DateTime  @updatedAt

  tokensSenha     TokenSenha[]
  tokensEmail     TokenEmail[]
  dispositivos    DispositivoPush[]
  registrosSync   RegistroSync[]
  arquivosSync    ArquivoSync[]
  vinculos        VinculoEntidade[]
  usosCupom       UsoCupom[]
  resultadosComp  ResultadoCompeticao[]
  logsNotificacao LogNotificacao[]
  leiturasNoticia LeituraNoticia[]
  processos       ProcessoDespachante[]
  filiacoes       FiliacaoLiga[]

  // Marketplace
  lojas              Loja[]
  anuncios           Anuncio[]
  conversasComprador Conversa[]        @relation("conversaComprador")
  conversasVendedor  Conversa[]        @relation("conversaVendedor")
  mensagensMarket    Mensagem[]
  denunciasMarket    Denuncia[]
  bloqueiosFeitos    BloqueioUsuario[] @relation("bloqueioDono")
  bloqueiosRecebidos BloqueioUsuario[] @relation("bloqueioAlvo")
  destaquesCompra    DestaqueCompra[]
  assinaturas        AssinaturaApp[]
  eventos            EventoUsuario[]

  @@index([ultimoAcessoEm])
  @@map("usuarios_app")
}

/// Linha do tempo de ações do usuário no app — histórico para o backoffice.
/// ADITIVO e best-effort: registrar um evento NUNCA pode quebrar o fluxo que o
/// originou (conta, compra, sync). Apps antigos continuam funcionando; eles só
/// não emitem os eventos que dependem de endpoints novos (ex.: "tentou assinar").
model EventoUsuario {
  id        String     @id @default(cuid())
  usuarioId String
  usuario   UsuarioApp @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// Chave do tipo de evento (ver dominio/eventoUsuario.ts): CONTA_CRIADA,
  /// ASSINATURA_TENTATIVA, ASSINATURA_ATIVA, ASSINATURA_CANCELADA,
  /// ASSINATURA_EXPIRADA, ASSINATURA_REEMBOLSADA, DOC_CRIADO, DOC_EDITADO,
  /// DOC_REMOVIDO, ARMA_CRIADA, ARMA_EDITADA, ARMA_REMOVIDA.
  tipo      String
  /// Texto curto e legível para a timeline (ex.: "CRAF — Pistola Glock").
  descricao String?    @db.Text
  /// Origem/plataforma quando aplicável: IOS | ANDROID | APP | CUPOM | SISTEMA.
  origem    String?
  /// Metadados em JSON (ex.: { produtoId, status, registroId }).
  meta      String?    @db.Text
  criadoEm  DateTime   @default(now())

  @@index([usuarioId, criadoEm])
  @@map("eventos_usuario")
}

/// Assinatura de loja (App Store hoje; Google futuramente) de um usuário do app.
/// É a FONTE DA VERDADE do Premium pago no SERVIDOR: derivada das App Store
/// Server Notifications V2 e da App Store Server API, independente de o app
/// reabrir. Agrupada pelo `originalTransactionId`, estável entre renovações.
/// (Premium por CUPOM continua sendo reportado pelo app e NÃO vive aqui.)
model AssinaturaApp {
  id                    String      @id @default(cuid())
  /// Conta dona. Null = notificação órfã (ainda não casada com um usuário);
  /// re-vinculada quando o app reporta o originalTransactionId ou via API.
  usuarioId             String?
  usuario               UsuarioApp? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  /// IOS | ANDROID (validado na aplicação).
  plataforma            String      @default("IOS")
  /// Chave estável da loja que agrupa a assinatura e todas as suas renovações.
  originalTransactionId String      @unique
  /// SKU: premium_mensal | premium_anual | premium_parceiro.
  produtoId             String
  /// Tipo de premium correspondente: MENSAL | ANUAL | ANUAL_PARCEIRO.
  premiumTipo           String?
  /// ATIVA | EM_GRACA | CANCELADA_RENOVACAO | EXPIRADA | REEMBOLSADA | REVOGADA.
  /// CANCELADA_RENOVACAO = desligou a renovação mas ainda está no período pago.
  status                String      @default("ATIVA")
  /// Renovação automática ligada. false sem expirar = churn voluntário sinalizado.
  autoRenova            Boolean     @default(true)
  /// Ambiente da loja: Production | Sandbox.
  ambiente              String      @default("Production")
  /// Fim do período pago atual (expiresDate da transação).
  expiraEm              DateTime?
  /// Início da assinatura (purchaseDate da primeira transação).
  iniciouEm             DateTime?
  /// Quando desligou a renovação automática (sinal de churn voluntário).
  canceladaEm           DateTime?
  /// Quando efetivamente expirou/perdeu o acesso.
  expirouEm             DateTime?
  /// Motivo bruto (expiration_intent / revocation_reason / tipo da notificação).
  motivo                String?
  /// Acompanhamento da reconquista: PENDENTE | CONTATADO | RECUPERADO | PERDIDO.
  winbackStatus         String?
  winbackEm             DateTime?
  /// Anotação livre do operador no backoffice.
  observacao            String?     @db.Text
  /// Data do último evento aplicado (notificação/cron/backfill).
  ultimoEventoEm        DateTime?
  criadoEm              DateTime    @default(now())
  atualizadoEm          DateTime    @updatedAt

  eventos EventoAssinatura[]

  @@index([usuarioId])
  @@index([status])
  @@index([expiraEm])
  @@map("assinaturas_app")
}

/// Histórico cru de cada evento de assinatura — auditoria do "quando" e
/// idempotência por `notificationUUID` (reprocessar a mesma notificação é no-op).
model EventoAssinatura {
  id               String        @id @default(cuid())
  assinaturaId     String
  assinatura       AssinaturaApp @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)
  /// notificationType da Apple (SUBSCRIBED, DID_RENEW, EXPIRED, REFUND, …) ou
  /// sintético (CRON_EXPIRADA, BACKFILL) para eventos gerados por nós.
  tipo             String
  /// subtype da Apple (AUTO_RENEW_DISABLED, VOLUNTARY, BILLING_RETRY, …).
  subtipo          String?
  /// UUID da notificação (idempotência). Null em eventos sintéticos.
  notificationUUID String?       @unique
  /// Payload decodificado para auditoria/depuração (JSON serializado em texto).
  payload          String?       @db.LongText
  criadoEm         DateTime      @default(now())

  @@index([assinaturaId])
  @@map("eventos_assinatura")
}

/// Processo de despachante contratado pelo usuário (Renovação de CRAF / Emissão
/// de Guias). Fonte da verdade do andamento; o app recebe o espelho via sync
/// (RegistroSync tipo 'processos'). A cobrança roda pelo Asaas (fora do IAP, por
/// ser serviço do mundo real). Valor NÃO inclui GRU.
model ProcessoDespachante {
  id             String   @id @default(cuid())
  usuarioId      String
  /// Código do serviço (ServicoDespachante.codigo). Serviços legados mantidos.
  tipoServico    String
  /// Código do status atual (StatusProcessoDespachante.codigo). Dinâmico/CRUD.
  status         String   @default("aguardando_pagamento")
  valorCentavos  Int
  quantidade     Int      @default(1)
  /// Arma alvo (solta, sem FK) + nome em snapshot — sobrevive à exclusão.
  armaId         String?
  armaNome       String?
  /// Id do pagamento no Asaas e link do checkout hospedado (PIX/cartão).
  asaasPaymentId String?  @unique
  invoiceUrl     String?
  /// Anotação interna do despachante (não vai para o app).
  observacao     String?  @db.Text
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  usuario UsuarioApp @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  valores ValorCampoProcessoDespachante[]

  @@index([usuarioId])
  @@index([status])
  @@map("processos_despachante")
}

/// Preço configurável de cada serviço do despachante, editável no backoffice
/// (muda sem update do app). `gruCentavos` = taxa do órgão (GRU, por item);
/// `servicoCentavos` = honorário do despachante. Total cobrado = soma dos dois.
/// Sem linha para um tipo, o servidor usa os defaults de dominio/despachante.ts.
model ServicoDespachanteConfig {
  tipoServico     String   @id /// RENOVACAO_CRAF | EMISSAO_GUIA
  gruCentavos     Int
  servicoCentavos Int
  ativo           Boolean  @default(true)
  atualizadoEm    DateTime @updatedAt

  @@map("servicos_despachante_config")
}

/// Catálogo DINÂMICO de serviços do despachante (CRUD no backoffice). Substitui
/// a lista antes hardcoded. `codigo` é estável e é o que vai no processo
/// (tipoServico) e no sync — serviços legados mantêm o mesmo código, então apps
/// antigos continuam funcionando. `icone` = nome de ícone (Ionicons) que o app
/// renderiza. Preço = gruCentavos + servicoCentavos.
model ServicoDespachante {
  id                     String   @id @default(cuid())
  codigo                 String   @unique
  nome                   String
  subtitulo              String?
  descricao              String   @db.Text
  /// Texto "como funciona" (passos), editável — antes hardcoded no app.
  comoFunciona           String?  @db.Text
  /// Nome do ícone (Ionicons) exibido no card do app.
  icone                  String   @default("briefcase-outline")
  gruCentavos            Int      @default(0)
  servicoCentavos        Int      @default(0)
  unidade                String   @default("por processo")
  ativo                  Boolean  @default(true)
  ordem                  Int      @default(0)
  /// Mensagem de WhatsApp enviada ao INICIAR o processo (pago), por serviço.
  mensagemWhatsappInicio String?  @db.Text
  criadoEm               DateTime @default(now())
  atualizadoEm           DateTime @updatedAt

  campos CampoServicoDespachante[]

  @@map("servicos_despachante")
}

/// Status DINÂMICO do processo (CRUD no backoffice): label, cor e ícone/bolinha.
/// `papel` dá a semântica de automação e MAPEIA para um dos 5 códigos legados no
/// sync (`status` que apps antigos entendem) — status novos nunca quebram apps
/// antigos, que recebem o código-base equivalente + os campos ricos aditivos.
/// papel: INICIAL | PAGO | AGUARDANDO_DOC | EM_ANALISE | NORMAL | FINAL | CANCELADO
model StatusProcessoDespachante {
  id           String   @id @default(cuid())
  codigo       String   @unique
  label        String
  cor          String   @default("#8a8f98")
  /// Nome do ícone (Ionicons). Vazio = bolinha com a cor.
  icone        String?
  papel        String   @default("NORMAL")
  ordem        Int      @default(0)
  ativo        Boolean  @default(true)
  atualizadoEm DateTime @updatedAt

  @@map("status_processo_despachante")
}

/// Campo do FORMULÁRIO por serviço (CRUD no backoffice). Tipos:
///   ARQUIVO   — upload de documento
///   TEXTO     — texto livre
///   CHECKBOX  — confirmação (sim/não)
///   SENHA_GOV — CPF + senha do gov.br (credencial sensível; só o despachante vê)
/// `descricao` explica o que é / onde conseguir, para guiar o usuário.
model CampoServicoDespachante {
  id          String   @id @default(cuid())
  servicoId   String
  tipo        String   @default("ARQUIVO")
  nome        String
  descricao   String?  @db.Text
  obrigatorio Boolean  @default(true)
  ordem       Int      @default(0)
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  servico ServicoDespachante @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@index([servicoId])
  @@map("campos_servico_despachante")
}

/// Valor preenchido de um campo em um processo (resposta do usuário) OU anexo
/// final entregue pelo despachante. Um registro por (processo, campo) para
/// respostas do usuário; anexos finais têm campoId nulo (vários permitidos).
/// origem: USUARIO | DESPACHANTE · status (revisão do doc do usuário): ENVIADO |
/// APROVADO | REJEITADO. Arquivos guardados como bytes (igual a ArquivoSync).
/// SENHA_GOV guarda `valorCpf` + `valorTexto` (a senha); NUNCA vai para o app.
model ValorCampoProcessoDespachante {
  id           String   @id @default(cuid())
  processoId   String
  campoId      String?
  tipo         String
  /// ARQUIVO:
  nome         String?
  mime         String?
  tamanho      Int?
  conteudo     Bytes?
  /// TEXTO / CHECKBOX ("true"/"false") / SENHA_GOV (senha):
  valorTexto   String?  @db.Text
  /// SENHA_GOV: CPF informado.
  valorCpf     String?
  origem       String   @default("USUARIO")
  final        Boolean  @default(false)
  status       String   @default("ENVIADO")
  motivo       String?  @db.Text
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  processo ProcessoDespachante @relation(fields: [processoId], references: [id], onDelete: Cascade)

  @@unique([processoId, campoId])
  @@index([processoId])
  @@map("valores_campo_processo_despachante")
}

/// Configuração da integração com o Asaas, editável pelo backoffice (singleton,
/// id = "unico"). Se não houver linha, o servidor cai nas variáveis de ambiente
/// (ASAAS_*) — compatível com deploys anteriores. apiKey/webhookToken são
/// segredos; o backoffice só mostra se estão definidos, nunca o valor.
model ConfiguracaoAsaas {
  id           String   @id @default("unico")
  /// sandbox | producao
  ambiente     String   @default("sandbox")
  apiKey       String?  @db.Text
  webhookToken String?
  atualizadoEm DateTime @updatedAt

  @@map("configuracao_asaas")
}

/// Filiação de um usuário à liga esportiva. Produto principal: anuidade que dá
/// 1 ano de vínculo associativo (provas nacionais / validade PF), concede o
/// Premium no app, carteirinha digital e certificado. A cobrança roda pelo Asaas
/// como ASSINATURA ANUAL recorrente (fora do IAP, por ser serviço do mundo real).
/// O app recebe o espelho via sync (RegistroSync tipo 'filiacoes'). ADITIVO:
/// apps antigos ignoram o tipo de sync desconhecido, nada quebra.
model FiliacaoLiga {
  id                   String   @id @default(cuid())
  usuarioId            String
  /// Número de registro público da filiação (ex. "2026-000123"). Atribuído ao
  /// ativar (pagamento confirmado / migração). Null enquanto pendente. Único.
  numeroFiliacao       String?  @unique
  /// pendente_pagamento | ativa | suspensa | vencida | cancelada
  status               String   @default("pendente_pagamento")
  /// ASAAS | CORTESIA_MIGRACAO (legado anual IAP migrado por 12 meses)
  origem               String   @default("ASAAS")

  // Dados do filiado (snapshot no momento da filiação).
  nomeCompleto         String
  cpf                  String
  cep                  String?
  logradouro           String?
  numero               String?
  complemento          String?
  bairro               String?
  cidade               String?
  uf                   String?
  /// CNH | RG | RNE | OUTRO
  docTipo              String?
  /// registroId do ArquivoSync com a imagem/PDF do documento de identificação.
  docArquivoId         String?
  documentacaoCompleta Boolean  @default(false)

  // Pagamento (Asaas, assinatura recorrente anual).
  asaasSubscriptionId  String?  @unique
  invoiceUrl           String?
  valorCentavos        Int
  /// Até quando a filiação é válida (vínculo de 1 ano). Renovações estendem.
  vigenteAte           DateTime
  criadoEm             DateTime @default(now())
  atualizadoEm         DateTime @updatedAt

  usuario UsuarioApp @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([status])
  @@map("filiacoes_liga")
}

/// Configuração da filiação à liga (singleton, id = "unico"), editável pelo
/// backoffice sem update do app: valor da anuidade e identidade da liga
/// (nome + logo), usada no app, na carteirinha, no certificado PDF e na página
/// pública de verificação. Sem linha, usa os defaults de dominio/filiacao.ts.
model FiliacaoConfig {
  id            String   @id @default("unico")
  /// Valor da anuidade da liga, em centavos.
  valorCentavos Int      @default(0)
  ativo         Boolean  @default(true)
  /// Nome da liga exibido nos documentos (ex. "Liga Nacional de Tiro Esportivo").
  nomeLiga      String?
  /// Logo da liga como data URI (base64) ou URL. Enviado pelo backoffice.
  /// LongText: um data URI de imagem passa fácil dos 64KB do TEXT.
  logoUrl       String?  @db.LongText
  /// Conteúdo editável da tela da liga (JSON): titulo, subtitulo, vantagens[],
  /// credibilidade, termos. Null = o app usa o texto embutido (fallback).
  conteudoJson  String?  @db.LongText
  atualizadoEm  DateTime @updatedAt

  @@map("filiacao_config")
}

/// Eventos de produto/analytics (funil de onboarding). Aceita ANÔNIMO (antes de
/// criar conta) via `anonId` estável do aparelho, e associa à conta quando logado.
/// Best-effort: só alimenta métricas, nunca afeta o fluxo do app.
model EventoApp {
  id         String   @id @default(cuid())
  /// Id estável do aparelho (gerado no app), para medir o funil do anônimo.
  anonId     String
  usuarioId  String?
  /// Ex.: onb_iniciou, onb_passo_entrou, onb_passo_saiu, onb_pulou, onb_doc_subiu,
  /// onb_concluiu, liga_vista, liga_filiou, liga_mensal, liga_recusou.
  evento     String
  /// Passo do onboarding quando aplicável: conta|validar|cr|craf|liga.
  passo      String?
  /// JSON livre (ex.: { tipoDoc, duracaoMs }).
  meta       String?  @db.Text
  plataforma String?
  appVersao  String?
  criadoEm   DateTime @default(now())

  @@index([evento])
  @@index([criadoEm])
  @@index([anonId])
  @@map("eventos_app")
}

/// Cupom promocional que libera o Premium. Gerenciado pelo backoffice.
model CupomPromocional {
  id         String    @id @default(cuid())
  /// Código normalizado (minúsculo, espaços colapsados). Único.
  codigo     String    @unique
  descricao  String?   @db.Text
  ativo      Boolean   @default(true)
  /// null = usos ilimitados.
  limiteUsos Int?
  usos       Int       @default(0)
  expiraEm   DateTime?
  criadoEm   DateTime  @default(now())

  registrosUso UsoCupom[]

  @@map("cupons_promocionais")
}

/// Registro de cada resgate de um cupom (quem e quando).
model UsoCupom {
  id        String   @id @default(cuid())
  cupomId   String
  usuarioId String?
  criadoEm  DateTime @default(now())

  cupom   CupomPromocional @relation(fields: [cupomId], references: [id], onDelete: Cascade)
  usuario UsuarioApp?      @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([cupomId])
  @@map("usos_cupom")
}

/// Vínculo (filiação) de um usuário do app a uma entidade de tiro.
/// Um usuário pode estar vinculado a VÁRIAS entidades.
model VinculoEntidade {
  id         String   @id @default(cuid())
  usuarioId  String
  entidadeId String
  /// SHOOTING_HOUSE (automático) | MANUAL (pelo backoffice)
  origem     String   @default("SHOOTING_HOUSE")
  criadoEm   DateTime @default(now())

  usuario  UsuarioApp   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  entidade EntidadeTiro @relation(fields: [entidadeId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, entidadeId])
  @@index([entidadeId])
  @@map("vinculos_entidade")
}

/// Espelho na nuvem dos registros do usuário (armas, documentos, habitualidades,
/// locais…). Genérico por `tipo` + `dados` JSON. LWW por `atualizadoEm`;
/// `carimboServidor` é o cursor do pull. `removido` = tombstone.
model RegistroSync {
  id              String   @id @default(cuid())
  usuarioId       String
  tipo            String
  registroId      String
  dados           String   @db.LongText
  atualizadoEm    DateTime
  removido        Boolean  @default(false)
  carimboServidor DateTime @updatedAt

  usuario UsuarioApp @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, tipo, registroId])
  @@index([usuarioId, carimboServidor])
  @@map("registros_sync")
}

/// Conteúdo binário dos arquivos/fotos do usuário (anexos de documentos, fotos
/// de armas). Guardado no nosso backend; `registroId` casa com o metadado.
model ArquivoSync {
  id           String   @id @default(cuid())
  usuarioId    String
  registroId   String
  mime         String?
  tamanho      Int?
  conteudo     Bytes
  atualizadoEm DateTime @updatedAt

  usuario UsuarioApp @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, registroId])
  @@index([usuarioId])
  @@map("arquivos_sync")
}

/// Token de push (Expo) de um aparelho. Pode estar sem usuário (anônimo) ou
/// associado a uma conta. Um usuário pode ter vários aparelhos.
model DispositivoPush {
  id           String   @id @default(cuid())
  /// null = aparelho anônimo (ainda sem conta ou após logout). Recebe "Todos".
  usuarioId    String?
  /// Expo push token (ExponentPushToken[...]). Único por aparelho.
  token        String   @unique
  /// IOS | ANDROID
  plataforma   String
  /// Versão de marketing do app reportada no registro (ex.: "1.8.1"). Null em
  /// apps antigos que ainda não mandam — tratados como "desconhecida".
  appVersao    String?
  /// Premium reportado pelo APARELHO. Cobre compras de usuários ANÔNIMOS (sem
  /// conta, que não reportam via /presenca). Reflete o cache da loja no aparelho.
  premium      Boolean  @default(false)
  /// Origem do premium do aparelho: CUPOM | MENSAL | ANUAL | ANUAL_PARCEIRO.
  premiumTipo  String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario UsuarioApp? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@map("dispositivos_push")
}

/// Histórico de disparos de push feitos pelo backoffice.
model EnvioPush {
  id            String   @id @default(cuid())
  titulo        String
  corpo         String   @db.Text
  /// TODOS | ENTIDADE | USUARIO | INATIVOS
  alvoTipo      String
  /// Referência do alvo: entidadeId, usuarioId ou nº de dias (INATIVOS).
  alvoRef       String?
  totalUsuarios Int      @default(0)
  totalTokens   Int      @default(0)
  totalAceitos  Int      @default(0)
  autorId       String?
  criadoEm      DateTime @default(now())

  @@map("envios_push")
}

/// Campanha de mensagens de WhatsApp (relacionamento) disparada pelo backoffice.
/// O disparo é gradual (um EnvioWhats por vez, intervalo aleatório). Toda a
/// durabilidade vem do banco: após restart, campanhas EM_ANDAMENTO são retomadas.
model CampanhaWhats {
  id            String   @id @default(cuid())
  mensagem      String   @db.Text
  /// Se true, {{nome}} foi substituído pelo primeiro nome de cada destinatário.
  usarNome      Boolean  @default(true)
  /// Snapshot (JSON) dos filtros usados para resolver os destinatários.
  filtros       String   @db.Text
  /// Intervalo entre envios, em segundos (sorteado entre min e max).
  intervaloMin  Int      @default(10)
  intervaloMax  Int      @default(40)
  /// EM_ANDAMENTO | PAUSADA | CONCLUIDA | CANCELADA
  status        String   @default("EM_ANDAMENTO")
  totalAlvos    Int
  totalEnviados Int      @default(0)
  totalFalhas   Int      @default(0)
  autorId       String?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  envios EnvioWhats[]

  @@index([status])
  @@map("campanhas_whats")
}

/// Um destinatário de uma campanha de WhatsApp, com a mensagem já personalizada.
model EnvioWhats {
  id         String    @id @default(cuid())
  campanhaId String
  /// Usuário do app de origem (pode ser null se a conta sumir depois).
  usuarioId  String?
  /// Celular (só dígitos) alvo do envio.
  celular    String
  nome       String
  /// Texto final já com o primeiro nome aplicado.
  mensagem   String    @db.Text
  /// PENDENTE | ENVIADO | FALHOU
  status     String    @default("PENDENTE")
  erro       String?   @db.Text
  enviadoEm  DateTime?
  criadoEm   DateTime  @default(now())

  campanha CampanhaWhats @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

  @@index([campanhaId, status])
  @@map("envios_whats")
}

/// Modelo de mensagem automática (relacionamento), editável no backoffice.
/// Cada (gatilho, canal) tem um texto próprio com {{nome}} (primeiro nome).
/// Gatilhos: BOAS_VINDAS (no cadastro) | SEM_ARMA_7D (7 dias sem cadastrar arma).
/// Canais: WHATSAPP | PUSH.
model ModeloMensagem {
  id           String   @id @default(cuid())
  gatilho      String
  canal        String
  /// Título (usado só no canal PUSH).
  titulo       String?
  /// Texto da mensagem (WhatsApp) ou corpo (push). Aceita {{nome}}.
  corpo        String   @db.Text
  ativo        Boolean  @default(true)
  atualizadoEm DateTime @updatedAt

  @@unique([gatilho, canal])
  @@map("modelos_mensagem")
}

/// Registro de que um disparo automático já foi feito para um usuário, para não
/// repetir (ex.: a mensagem de 7 dias sem arma só sai uma vez por usuário/canal).
model DisparoAutomatico {
  id        String   @id @default(cuid())
  usuarioId String
  gatilho   String
  canal     String
  /// OK | FALHOU | PULADO (ex.: WhatsApp desconectado / sem número).
  status    String   @default("OK")
  erro      String?  @db.Text
  criadoEm  DateTime @default(now())

  @@unique([usuarioId, gatilho, canal])
  @@index([gatilho])
  @@map("disparos_automaticos")
}

/// Configurações globais simples (chave/valor). Ex.: automacoes_ativas = "1".
model Configuracao {
  chave        String   @id
  valor        String   @db.Text
  atualizadoEm DateTime @updatedAt

  @@map("configuracoes")
}

/// Log de auditoria de envios automáticos (WhatsApp/push) e de notícias.
/// Append-only: alimenta o histórico por usuário no backoffice e a regra de
/// não repetir a mesma automação para a pessoa dentro de 1 mês.
model LogNotificacao {
  id           String   @id @default(cuid())
  usuarioId    String?
  /// WHATSAPP | PUSH
  canal        String
  /// BOAS_VINDAS | SEM_ARMA_7D | INATIVO_30D | WINBACK | NOTICIA
  tipo         String
  /// noticiaId quando tipo = NOTICIA (ou outro id de referência).
  referenciaId String?
  titulo       String?  @db.Text
  /// Texto efetivamente enviado (corpo da mensagem, já com o nome aplicado).
  /// Permite auditar exatamente o que a pessoa recebeu (ex.: push de reconquista).
  corpo        String?  @db.Text
  /// Destino resumido (ex.: celular no WhatsApp).
  destino      String?
  /// OK | FALHOU | PULADO
  status       String
  erro         String?  @db.Text
  criadoEm     DateTime @default(now())

  usuario UsuarioApp? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId, criadoEm])
  @@index([tipo, criadoEm])
  @@index([canal, criadoEm])
  @@map("logs_notificacao")
}

/// Token de redefinição de senha do usuário do app. Guardamos só o HASH do
/// token (nunca o valor em claro), com validade curta e marca de uso.
model TokenSenha {
  id         String    @id @default(cuid())
  usuarioId  String
  /// Hash (sha256) do código de 6 dígitos enviado por e-mail.
  tokenHash  String
  expiraEm   DateTime
  usadoEm    DateTime?
  /// Tentativas erradas; o código é invalidado após o limite (anti-força-bruta).
  tentativas Int       @default(0)
  criadoEm   DateTime  @default(now())

  usuario UsuarioApp @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("tokens_senha")
}

/// Código de confirmação de e-mail do usuário do app (6 dígitos, por e-mail).
model TokenEmail {
  id         String    @id @default(cuid())
  usuarioId  String
  /// Hash (sha256) do código de 6 dígitos.
  codigoHash String
  expiraEm   DateTime
  usadoEm    DateTime?
  tentativas Int       @default(0)
  criadoEm   DateTime  @default(now())

  usuario UsuarioApp @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("tokens_email")
}

/// Usuário administrativo de UMA entidade. Acessa o backoffice no escopo
/// da sua entidade apenas. Não tem relação com os usuários-admin do app.
model UsuarioEntidade {
  id           String   @id @default(cuid())
  entidadeId   String
  nome         String
  email        String
  senhaHash    String
  /// ADMIN_ENTIDADE | OPERADOR  (validado por Zod)
  papel        String   @default("ADMIN_ENTIDADE")
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  entidade EntidadeTiro @relation(fields: [entidadeId], references: [id], onDelete: Cascade)

  // E-mail único POR entidade (o mesmo e-mail pode existir em entidades diferentes).
  @@unique([entidadeId, email])
  @@index([entidadeId])
  @@map("usuarios_entidade")
}

/// Mensagem de contato recebida pelo formulário do site (sistema interno — sem
/// e-mail). Listada e tratada no backoffice.
model Contato {
  id       String   @id @default(cuid())
  nome     String
  telefone String
  assunto  String
  mensagem String   @db.Text
  /// Já foi atendido/respondido pela equipe.
  tratado  Boolean  @default(false)
  criadoEm DateTime @default(now())

  @@index([tratado, criadoEm])
  @@map("contatos")
}

// ============================================================================
// Marketplace de acessórios (classificados). Conteúdo público/compartilhado —
// NÃO usa o RegistroSync por-usuário. Só acessórios (allow-list + moderação);
// armas/munição são bloqueadas na aplicação. Tudo aditivo.
// ============================================================================

/// Loja parceira: vendedor curado e identificado, aprovado no backoffice.
/// Enquanto `ativo`, os anúncios da loja entram APROVADOS sem passar pela fila
/// de moderação (a curadoria é feita uma vez, ao aprovar o lojista).
model Loja {
  id           String   @id @default(cuid())
  usuarioId    String
  nome         String
  descricao    String?  @db.Text
  /// Logo pública (Upload.id, servida em /uploads/:id).
  logoUploadId String?
  site         String?
  /// Telefone público da loja (negócio) — diferente do anonimato do P2P.
  whatsapp     String?
  uf           String?
  cidade       String?
  verificada   Boolean  @default(false)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario  UsuarioApp @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  anuncios Anuncio[]

  @@index([usuarioId])
  @@map("lojas_marketplace")
}

/// Anúncio (classificado). P2P entra PENDENTE (aguarda moderação); de loja ativa
/// entra APROVADO. Só fica público quando status = APROVADO. `destaqueAte` no
/// futuro coloca o anúncio no topo (destaque pago via IAP).
model Anuncio {
  id             String    @id @default(cuid())
  vendedorId     String
  lojaId         String?
  categoria      String
  subcategoria   String?
  /// NOVO | SEMINOVO | USADO
  estadoUso      String
  /// null = "a combinar"
  precoCentavos  Int?
  uf             String
  cidade         String
  titulo         String
  descricao      String    @db.Text
  /// PENDENTE | APROVADO | PAUSADO | VENDIDO | REJEITADO
  status         String    @default("PENDENTE")
  motivoRejeicao String?
  /// Enquanto > agora, aparece no topo da lista (destaque pago).
  destaqueAte    DateTime?
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  vendedor  UsuarioApp       @relation(fields: [vendedorId], references: [id], onDelete: Cascade)
  loja      Loja?            @relation(fields: [lojaId], references: [id], onDelete: SetNull)
  fotos     AnuncioFoto[]
  conversas Conversa[]
  destaques DestaqueCompra[]

  @@index([status])
  @@index([categoria])
  @@index([uf])
  @@index([destaqueAte])
  @@index([vendedorId])
  @@map("anuncios_marketplace")
}

/// Foto de um anúncio (Upload.id), na ordem de exibição.
model AnuncioFoto {
  id        String @id @default(cuid())
  anuncioId String
  uploadId  String
  ordem     Int    @default(0)

  anuncio Anuncio @relation(fields: [anuncioId], references: [id], onDelete: Cascade)

  @@index([anuncioId])
  @@map("anuncio_fotos")
}

/// Conversa de um comprador interessado com o vendedor, única por anúncio+comprador.
/// `contatoLiberado` = o vendedor liberou o próprio telefone para ESTE comprador
/// (opt-in por conversa, reversível; LGPD).
model Conversa {
  id                String    @id @default(cuid())
  anuncioId         String
  compradorId       String
  vendedorId        String
  contatoLiberado   Boolean   @default(false)
  contatoLiberadoEm DateTime?
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  anuncio   Anuncio    @relation(fields: [anuncioId], references: [id], onDelete: Cascade)
  comprador UsuarioApp @relation("conversaComprador", fields: [compradorId], references: [id], onDelete: Cascade)
  vendedor  UsuarioApp @relation("conversaVendedor", fields: [vendedorId], references: [id], onDelete: Cascade)
  mensagens Mensagem[]

  @@unique([anuncioId, compradorId])
  @@index([compradorId])
  @@index([vendedorId])
  @@map("conversas_marketplace")
}

/// Mensagem de chat dentro de uma conversa.
model Mensagem {
  id         String    @id @default(cuid())
  conversaId String
  autorId    String
  texto      String    @db.Text
  criadoEm   DateTime  @default(now())
  lidaEm     DateTime?

  conversa Conversa   @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  autor    UsuarioApp @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@index([conversaId])
  @@map("mensagens_marketplace")
}

/// Denúncia de anúncio ou conversa (fila de moderação no backoffice).
model Denuncia {
  id            String   @id @default(cuid())
  anuncioId     String?
  conversaId    String?
  denuncianteId String?
  motivo        String   @db.Text
  tratada       Boolean  @default(false)
  criadoEm      DateTime @default(now())

  denunciante UsuarioApp? @relation(fields: [denuncianteId], references: [id], onDelete: SetNull)

  @@index([tratada])
  @@map("denuncias_marketplace")
}

/// Bloqueio de um usuário por outro (não vê anúncios/conversas do bloqueado).
model BloqueioUsuario {
  id          String   @id @default(cuid())
  usuarioId   String
  bloqueadoId String
  criadoEm    DateTime @default(now())

  usuario   UsuarioApp @relation("bloqueioDono", fields: [usuarioId], references: [id], onDelete: Cascade)
  bloqueado UsuarioApp @relation("bloqueioAlvo", fields: [bloqueadoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, bloqueadoId])
  @@index([usuarioId])
  @@map("bloqueios_usuario")
}

/// Compra de destaque (IAP consumível). Idempotente por `transacaoId`.
model DestaqueCompra {
  id          String    @id @default(cuid())
  anuncioId   String
  usuarioId   String
  produtoId   String
  /// IOS | ANDROID
  plataforma  String
  transacaoId String    @unique
  dias        Int
  validadoEm  DateTime?
  criadoEm    DateTime  @default(now())

  anuncio Anuncio    @relation(fields: [anuncioId], references: [id], onDelete: Cascade)
  usuario UsuarioApp @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([anuncioId])
  @@map("destaques_compra")
}
