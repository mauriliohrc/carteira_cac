# ----------------------------------------------------------------------------
# Banco de dados
#
# Agora: SQLite (arquivo local). Trocar para MySQL é mudar só estas duas coisas:
#   1) servidor/prisma/schema.prisma  ->  datasource.provider = "mysql"
#   2) DATABASE_URL abaixo para a string do MySQL
# Nada do código de negócio muda (o Prisma Client é agnóstico ao banco).
# ----------------------------------------------------------------------------

# SQLite (padrão de desenvolvimento)
DATABASE_URL="file:./dados/cacbrasil.db"

# MySQL (exemplo — use quando migrar)
# DATABASE_URL="mysql://usuario:senha@localhost:3306/cacbrasil"

# ----------------------------------------------------------------------------
# Autenticação
# ----------------------------------------------------------------------------
# Segredos DIFERENTES para cada público de login:
#   admin do app (backoffice) x usuário de entidade x usuário final do app.
JWT_SEGREDO_ADMIN="troque-este-segredo-admin-em-producao"
JWT_SEGREDO_ENTIDADE="troque-este-segredo-entidade-em-producao"
JWT_SEGREDO_APP="troque-este-segredo-app-em-producao"
JWT_EXPIRACAO="12h"
# Sessão do usuário final do app (Carteira CAC) dura mais.
JWT_EXPIRACAO_APP="60d"

# ----------------------------------------------------------------------------
# Servidor
# ----------------------------------------------------------------------------
PORTA=3333
# Origem do backoffice, para o CORS
BACKOFFICE_ORIGEM="http://localhost:3000"

# ----------------------------------------------------------------------------
# E-mail (SMTP) — verificação de conta e reset de senha
#
# Sem MAIL_USER/MAIL_PASS o envio fica desligado (os códigos só são logados e,
# fora de produção, devolvidos no corpo da resposta para teste).
# ----------------------------------------------------------------------------
MAIL_HOST="smtp.hostinger.com"
MAIL_PORT="465"
MAIL_USER="contato@carteiracac.com"
MAIL_PASS="troque-esta-senha"
MAIL_FROM="Carteira CAC <contato@carteiracac.com>"

# ----------------------------------------------------------------------------
# Seed — primeiro super admin do backoffice (criado por `npm run seed`)
# ----------------------------------------------------------------------------
SEED_ADMIN_NOME="Dono do App"
SEED_ADMIN_EMAIL="admin@cacbrasil.app"
SEED_ADMIN_SENHA="mudar123"

# ----------------------------------------------------------------------------
# WhatsApp (Baileys) — relacionamento/campanhas do backoffice
# Pasta onde ficam as credenciais da sessão (persistir entre deploys para não
# precisar ler o QR de novo). Padrão: .whatsapp-auth (ignorado no git).
# ----------------------------------------------------------------------------
WHATS_AUTH_DIR=".whatsapp-auth"

# ----------------------------------------------------------------------------
# Apple — assinaturas / churn (App Store Server Notifications V2 + Server API)
#
# O webhook /webhooks/apple liga quando APPLE_BUNDLE_ID está definido (a
# autenticidade vem da assinatura JWS da Apple, não de token). A App Store Server
# API (consulta/backfill de churn) liga quando, além do bundle, houver Key ID,
# Issuer ID e a chave privada .p8.
#
#  - APPLE_BUNDLE_ID: identificador do app (ex.: br.com.cacbrasil.carteira).
#  - APPLE_APP_APPLE_ID: "Apple ID" numérico do app (App Store Connect › App ›
#    General › App Information). Exigido para verificar notificações de PRODUÇÃO.
#  - APPLE_ASC_KEY_ID / APPLE_ASC_ISSUER_ID / APPLE_ASC_PRIVATE_KEY: chave de
#    In-App Purchase gerada em Users and Access › Integrations › In-App Purchase.
#    A chave (.p8) pode ir com \n escapado numa linha só.
#  - APPLE_AMBIENTE: Production | Sandbox (fallback quando a notificação não traz).
# ----------------------------------------------------------------------------
APPLE_BUNDLE_ID="br.com.cacbrasil.carteira"
APPLE_APP_APPLE_ID=""
APPLE_ASC_KEY_ID=""
APPLE_ASC_ISSUER_ID=""
APPLE_ASC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_AMBIENTE="Production"

# ----------------------------------------------------------------------------
# Google Play — assinaturas / churn Android (Real-time Developer Notifications
# via Pub/Sub + Android Publisher API). Espelha a Apple no servidor.
#
# O webhook /webhooks/google e a consulta de status ligam quando houver pacote +
# credenciais da Service Account. A RTDN só traz o purchaseToken; o estado atual
# é lido da subscriptionsv2.get com um token OAuth2 assinado pela Service Account.
#
#  - GOOGLE_PACKAGE_NAME: applicationId do app Android (ex.: br.com.cacbrasil.carteira).
#  - GOOGLE_SA_CLIENT_EMAIL / GOOGLE_SA_PRIVATE_KEY: da chave JSON de uma Service
#    Account com acesso ao app na Play Console (Pedidos/Dados financeiros). A
#    private_key vai com \n escapado numa linha só.
#  - GOOGLE_PUBSUB_TOKEN: segredo compartilhado exigido na URL do webhook
#    (/webhooks/google?token=…), já que o push do Pub/Sub não é assinado.
# ----------------------------------------------------------------------------
GOOGLE_PACKAGE_NAME="br.com.cacbrasil.carteira"
GOOGLE_SA_CLIENT_EMAIL=""
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_PUBSUB_TOKEN=""
