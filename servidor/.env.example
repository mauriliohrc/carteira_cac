# ----------------------------------------------------------------------------
# Banco de dados
#
# Agora: SQLite (arquivo local). Trocar para MySQL é mudar só estas duas coisas:
#   1) servidor/prisma/schema.prisma  ->  datasource.provider = "mysql"
#   2) DATABASE_URL abaixo para a string do MySQL
# Nada do código de negócio muda (o Prisma Client é agnóstico ao banco).
# ----------------------------------------------------------------------------

# SQLite (padrão de desenvolvimento)
DATABASE_URL="file:./dados/cacbrasil.db"

# MySQL (exemplo — use quando migrar)
# DATABASE_URL="mysql://usuario:senha@localhost:3306/cacbrasil"

# ----------------------------------------------------------------------------
# Autenticação
# ----------------------------------------------------------------------------
# Segredos DIFERENTES para cada público de login:
#   admin do app (backoffice) x usuário de entidade x usuário final do app.
JWT_SEGREDO_ADMIN="troque-este-segredo-admin-em-producao"
JWT_SEGREDO_ENTIDADE="troque-este-segredo-entidade-em-producao"
JWT_SEGREDO_APP="troque-este-segredo-app-em-producao"
JWT_EXPIRACAO="12h"
# Sessão do usuário final do app (Carteira CAC) dura mais.
JWT_EXPIRACAO_APP="60d"

# ----------------------------------------------------------------------------
# Servidor
# ----------------------------------------------------------------------------
PORTA=3333
# Origem do backoffice, para o CORS
BACKOFFICE_ORIGEM="http://localhost:3000"

# ----------------------------------------------------------------------------
# E-mail (SMTP) — verificação de conta e reset de senha
#
# Sem MAIL_USER/MAIL_PASS o envio fica desligado (os códigos só são logados e,
# fora de produção, devolvidos no corpo da resposta para teste).
# ----------------------------------------------------------------------------
MAIL_HOST="smtp.hostinger.com"
MAIL_PORT="465"
MAIL_USER="contato@carteiracac.com"
MAIL_PASS="troque-esta-senha"
MAIL_FROM="Carteira CAC <contato@carteiracac.com>"

# ----------------------------------------------------------------------------
# Seed — primeiro super admin do backoffice (criado por `npm run seed`)
# ----------------------------------------------------------------------------
SEED_ADMIN_NOME="Dono do App"
SEED_ADMIN_EMAIL="admin@cacbrasil.app"
SEED_ADMIN_SENHA="mudar123"
