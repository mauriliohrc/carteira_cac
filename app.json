{
  "expo": {
    "name": "Carteira CAC",
    "slug": "cac-brasil",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cacbrasil",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#101310",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.cacbrasil.carteira",
      "buildNumber": "9",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "A Carteira CAC usa suas fotos para você anexar imagens dos seus documentos — CRAF, guia de tráfego, laudo e CR — à carteira. As imagens ficam salvas só neste aparelho.",
        "NSCameraUsageDescription": "A Carteira CAC usa a câmera para você fotografar seus documentos — CRAF, guia de tráfego, laudo e CR — e anexá-los à carteira. As fotos ficam salvas só neste aparelho.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.com.cacbrasil.carteira",
      "versionCode": 9,
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#0F3D1E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F3D1E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 300,
          "dark": {
            "backgroundColor": "#0A2712",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#93AD65",
          "defaultChannel": "vencimentos"
        }
      ],
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "A Carteira CAC usa suas fotos para você anexar imagens dos seus documentos — CRAF, guia de tráfego, laudo e CR — à carteira. As imagens ficam salvas só neste aparelho.",
          "cameraPermission": "A Carteira CAC usa a câmera para você fotografar seus documentos — CRAF, guia de tráfego, laudo e CR — e anexá-los à carteira. As fotos ficam salvas só neste aparelho.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "A Carteira CAC usa o Face ID para desbloquear o app sem digitar o PIN, mantendo seu acervo privado."
        }
      ],
      "expo-iap",
      "./plugins/withSceneLifecycle"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "legal": {
        "termosUrl": "https://www.apple.com/legal/internet-services/itunes/dev/stdeula/",
        "privacidadeUrl": "https://carteiracac.com/privacidade.html"
      },
      "revenueCat": {
        "ios": "",
        "android": ""
      },
      "router": {},
      "eas": {
        "projectId": "6eb2d1cd-e1cf-4826-9052-9d5a79a8cb86"
      }
    },
    "owner": "mhrc"
  }
}
